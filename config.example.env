# ── codex-cloud-assistant 配置模板 ────────────────────────────────────────────
# 用法：cp config.example.env config.env  然后按需修改；systemd 用 EnvironmentFile 指向它。
# ⛔ config.env 含密钥，权限请设 600，且**不要**提交进 git。

# ── 基础 ─────────────────────────────────────────────────────────────────────
HARNESS_ACCOUNTS_PORT=8091
HARNESS_ACCOUNTS_FILE=/opt/codex-cloud-admin/data/data.json

# ⛔⛔ 必填：你的管理面板域名（多个用英文逗号分隔，含协议）。
#     留空 ⇒ 浏览器带 Origin 的请求会被拒（面板登录 403）。
#     例：HARNESS_ACCOUNTS_ORIGINS=https://admin.example.com,https://www.example.com
HARNESS_ACCOUNTS_ORIGINS=

# 注册赠送积分（默认 1000）
HARNESS_SIGNUP_POINTS=1000

# 注册邀请码（留空 = 不需要邀请码即可注册）
HARNESS_REGISTER_INVITE_CODE=

# 每账号最多绑定机器数 / 存储上限（字节）
HARNESS_DEVICE_LIMIT=3
HARNESS_STORAGE_LIMIT=1073741824

# ── 上游模型网关（也可在面板「上游 API」里配，面板优先）────────────────────
# 支持 https:// / http:// / 裸主机（自动补 https）/ 内网 IP / 端口 / 路径前缀
WBM_BASE=
# 网关密钥（Bearer）
WBM_GATEWAY_KEY=
# 目录同步专用令牌（WBM 专有端点用；不填则用 WBM_GATEWAY_KEY）
WBM_TOKEN=

# ── 模型代理并发（11-06）────────────────────────────────────────────────────
# 本服务对上游账号池的**同时在途**上限。用户报「上游通道已满（当前上限 2 路并发），
# 请稍后重试」就是撞在这里（长会话一条就占满，第二条直接 503）。
# ⛔ 必须 ≤ 上游账号池的 pool.max_in_flight_global（wb2api config.json），否则队列没意义 ——
#    两边都抬到 10 才是真 10 路；只抬一边等于把 503 挪到上游。
HARNESS_PROXY_MAX_INFLIGHT=10
# 排队等待上限：超过并发就先排队，排满/等超时才回 503（带 Retry-After）
HARNESS_PROXY_QUEUE_WAIT_MS=60000

# ── 知识库 / 记忆空间（可选；也可在面板里配）───────────────────────────────
# ⛔ 知识库鉴权头是 X-API-Key；记忆是 Authorization: Bearer（别弄反）
WEKNORA_BASE=
WEKNORA_ADMIN_KEY=
WEKNORA_LLM_MODEL_ID=
WEKNORA_EMBED_MODEL_ID=
WEKNORA_VLM_MODEL_ID=
MEMHUB_BASE=
MEMHUB_PROXY_BASE=
MEMHUB_ADMIN_KEY=
MEMHUB_INSTANCE=default

# ── 版本与更新 ───────────────────────────────────────────────────────────────
# 面板「检查更新」用它对比最新 tag
HARNESS_REPO_URL=https://github.com/PMZPZM0/codex-cloud-assistant
